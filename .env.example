# Local-only example values. Never reuse them outside local development.
DJANGO_SETTINGS_MODULE=src.config.settings.development
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://kan_local_app:local-only@db:5432/kan_local
DATABASE_ENV=local
POSTGRES_DB=kan_local
POSTGRES_USER=kan_local_app
POSTGRES_PASSWORD=local-only
WEB_PORT=8000

# Preview and Production must use separate provider-managed values.
# VERCEL_ENV=preview
# VERCEL_URL is injected by Vercel and must be an exact deployment hostname.
# VERCEL_PROJECT_PRODUCTION_URL is injected for Production canonical metadata.
# PUBLIC_BASE_URL=https://future-reviewed-custom-domain.example
# DJANGO_ALLOWED_HOSTS=optional-extra-exact-host.example
# DATABASE_ENV=preview
# DATABASE_URL=postgresql://preview-role:REDACTED@preview-host/preview-db?sslmode=require
